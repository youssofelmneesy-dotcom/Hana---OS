  "duas": [
    {
      "id": "dua-1",
      "title": "Dua for Anxiety and Sorrow",
      "category": "dua",
      "moods": [
        "overwhelmed",
        "sad",
        "tired",
        "need-spiritual"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "anxiety",
        "comfort"
      ],
      "source": "internal",
      "duaText": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الهَمِّ وَالحَزَنِ، وَأَعُوذُ بِكَ مِنَ العَجْزِ وَالكَسَلِ، وَأَعُوذُ بِكَ مِنَ الجُبْنِ وَالبُخْلِ، وَأَعُوذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ وَقَهْرِ الرِّجَالِ",
      "duaTranslation": "O Allah, I seek refuge in You from anxiety and sorrow, from incapacity and laziness, from cowardice and miserliness, and from the burden of debt and being overcome by people.",
      "duaSource": "Sahih al-Bukhari 6369"
    },
    {
      "id": "dua-2",
      "title": "Dua for Strength",
      "category": "dua",
      "moods": [
        "overwhelmed",
        "need-spiritual",
        "tired"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "dua",
        "strength",
        "patience"
      ],
      "source": "internal",
      "duaText": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
      "duaTranslation": "Allah is sufficient for us, and He is the best Disposer of affairs.",
      "duaSource": "Qur'an 3:173"
    },
    {
      "id": "dua-3",
      "title": "Dua for Patience",
      "category": "dua",
      "moods": [
        "sad",
        "overwhelmed",
        "need-spiritual"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "dua",
        "patience",
        "hardship"
      ],
      "source": "internal",
      "duaText": "رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَتَوَفَّنَا مُسْلِمِينَ",
      "duaTranslation": "Our Lord, pour upon us patience and let us die as Muslims in submission to You.",
      "duaSource": "Qur'an 7:126"
    },
    {
      "id": "dua-4",
      "title": "Dua for Forgiveness",
      "category": "dua",
      "moods": [
        "need-spiritual",
        "calm",
        "sad"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "forgiveness",
        "repentance"
      ],
      "source": "internal",
      "duaText": "رَبِّ اغْفِرْ لِي وَتُبْ عَلَيَّ إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ",
      "duaTranslation": "My Lord, forgive me and accept my repentance. Indeed, You are the One who accepts repentance, the Most Merciful.",
      "duaSource": "Sunan Abi Dawud 1516"
    },
    {
      "id": "dua-5",
      "title": "Dua for Guidance",
      "category": "dua",
      "moods": [
        "need-spiritual",
        "calm",
        "okay"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "guidance",
        "clarity"
      ],
      "source": "internal",
      "duaText": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
      "duaTranslation": "Guide us to the straight path.",
      "duaSource": "Qur'an 1:6"
    },
    {
      "id": "dua-6",
      "title": "Dua for Gratitude",
      "category": "dua",
      "moods": [
        "good",
        "calm",
        "need-spiritual"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "dua",
        "gratitude",
        "blessings"
      ],
      "source": "internal",
      "duaText": "اللَّهُمَّ أَعِنِّي عَلَى ذِكْرِكَ وَشُكْرِكَ وَحُسْنِ عِبَادَتِكَ",
      "duaTranslation": "O Allah, help me remember You, thank You, and worship You well.",
      "duaSource": "Sunan Abi Dawud 1526"
    },
    {
      "id": "dua-7",
      "title": "Dua for Protection",
      "category": "dua",
      "moods": [
        "overwhelmed",
        "sad",
        "tired",
        "need-spiritual"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "protection",
        "peace"
      ],
      "source": "internal",
      "duaText": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ",
      "duaTranslation": "I seek refuge in Allah from the accursed Satan.",
      "duaSource": "Qur'an 16:98"
    },
    {
      "id": "dua-8",
      "title": "Morning Dua",
      "category": "dua",
      "moods": [
        "good",
        "calm",
        "need-spiritual"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "dua",
        "morning",
        "daily"
      ],
      "source": "internal",
      "duaText": "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ",
      "duaTranslation": "We have reached the morning and sovereignty belongs to Allah. Praise belongs to Allah. There is no deity but Allah alone, without partner; His is the dominion and His is the praise, and He is over all things capable.",
      "duaSource": "Hisn al-Muslim 77"
    },
    {
      "id": "dua-9",
      "title": "Evening Dua",
      "category": "dua",
      "moods": [
        "calm",
        "tired",
        "need-spiritual",
        "late-night"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "evening",
        "protection"
      ],
      "source": "internal",
      "duaText": "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ",
      "duaTranslation": "We have reached the evening and sovereignty belongs to Allah. Praise belongs to Allah. There is no deity but Allah alone, without partner; His is the dominion and His is the praise, and He is over all things capable.",
      "duaSource": "Hisn al-Muslim 77"
    },
    {
      "id": "dua-10",
      "title": "Dua Before Sleep",
      "category": "dua",
      "moods": [
        "tired",
        "calm",
        "need-spiritual",
        "late-night"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "dua",
        "sleep",
        "night"
      ],
      "source": "internal",
      "duaText": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
      "duaTranslation": "In Your name, O Allah, I die and I live.",
      "duaSource": "Sahih Muslim 2711"
    }
  ],
  "adhkar": [
    {
      "id": "adhkar-morning-1",
      "title": "Morning — Ayat al-Kursi",
      "category": "adhkar",
      "group": "morning",
      "moods": [
        "good",
        "calm",
        "need-spiritual"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "adhkar",
        "morning",
        "protection"
      ],
      "source": "internal",
      "text": "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ",
      "repeat": 1,
      "reference": "Qur'an 2:255 • Hisn al-Muslim 75"
    },
    {
      "id": "adhkar-morning-2",
      "title": "Morning — Sayyid al-Istighfar",
      "category": "adhkar",
      "group": "morning",
      "moods": [
        "need-spiritual",
        "calm",
        "overwhelmed"
      ],
      "energy": 1,
      "language": "arabic",
      "tags": [
        "adhkar",
        "morning",
        "forgiveness"
      ],
      "source": "internal",
      "text": "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ لَكَ بِذَنْبِي فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ",
      "repeat": 1,
      "reference": "Sahih al-Bukhari • Hisn al-Muslim 79"
    },
    {
      "id": "adhkar-morning-3",
      "title": "Morning — Subhan Allah wa bihamdihi",
      "category": "adhkar",
      "group": "morning",
      "moods": [
        "good",
        "calm",
        "need-spiritual"
      ],
      "energy": 2,
      "language": "arabic",
      "tags": [
        "adhkar",
        "morning",
        "tasbih"
      ],
      "source": "internal",
      "text": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ",
